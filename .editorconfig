root = true

[*.gd]
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

[*.tscn]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8

[*.tres]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
